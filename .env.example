# Supabase (project region: ap-south-1)
# Values must be supplied in .env (never commit real secrets)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Extraction mode: cached (demo, uses pre-saved JSON) | live (calls Gemini)
EXTRACTION_MODE=cached

# Field confidence threshold (0-1). Fields at/below this -> needs_review.
CONFIDENCE_THRESHOLD=0.80

# Weight cross-check tolerance (fraction, e.g. 0.005 = 0.5%)
WEIGHT_TOLERANCE=0.005

# Max upload size in bytes (10 MB)
MAX_UPLOAD_SIZE=10485760

# Demo user password (used by scripts/seed.py --load; random if unset)
DEMO_PASSWORD=

# App
NEXT_PUBLIC_APP_URL=
